% [uy] = Function_addnoise_SNR(60,uy);
% [urz] = Function_addnoise_SNR(60,urz);
% [X] = Function_addnoise_SNR(60,X);
% [Y] = Function_addnoise_SNR(60,Y);
% [Rz] = Function_addnoise_SNR(60,Rz);


% save ux ux;
% save uy uy;
% save urz urz;
% 
% save ux1 ux1;
% save uy1 uy1;
% save urz1 urz1;
% 
% save X X;
% save Y Y;
% save Rz Rz;




test1;
% MISO;